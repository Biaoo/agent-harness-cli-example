{
  "id": "research",
  "version": 1,
  "description": "A main-text-insight research workflow. The workflow creates a topic-specific directory under research/ and either advances toward a publishable main insight or routes back for repair; it does not support SI-only digestion or downgrade publication.",
  "initial": "research_context",
  "defaults": {
    "state_path": ".agent-harness/research-state.json",
    "report_dir": "reports/research"
  },
  "nodes": [
    {
      "id": "research_context",
      "type": "stage",
      "title": "Research Context",
      "artifacts": [
        {
          "name": "research_context",
          "path": "research/context.json",
          "type": "json",
          "required": true
        }
      ],
      "checks": [
        {
          "name": "research_context",
          "command": ["{python}", "checks/check_research_context.py"],
          "severity": "error",
          "config": {
            "path": "research/context.json"
          }
        }
      ],
      "transitions": [
        {
          "id": "start_idea_intake",
          "when": "passed",
          "action": "advance",
          "to": "idea_intake",
          "label": "进入 Idea Intake",
          "prompt": "研究上下文已创建。请读取 research/context.json，并在 research/<topic_slug>/idea_brief.md 中完成 Idea Intake。"
        }
      ]
    },
    {
      "id": "idea_intake",
      "type": "stage",
      "title": "Idea Intake",
      "artifacts": [
        {
          "name": "idea_brief",
          "path": "research/{topic_slug}/idea_brief.md",
          "type": "markdown",
          "required": true
        }
      ],
      "checks": [
        {
          "name": "idea_brief_sections",
          "command": ["{python}", "checks/check_markdown_sections.py"],
          "severity": "error",
          "config": {
            "path": "research/{topic_slug}/idea_brief.md",
            "min_chars": 900,
            "required_headings": [
              "# Idea Brief",
              "## World Phenomenon",
              "## Research Question",
              "## Idea Anchor",
              "## Scope Boundary",
              "## Status"
            ]
          }
        },
        {
          "name": "idea_intake_status",
          "command": ["{python}", "checks/check_research_status.py"],
          "severity": "error",
          "config": {
            "path": "research/{topic_slug}/idea_brief.md",
            "allowed_statuses": ["clarified", "too_broad", "needs_user_authority"]
          }
        },
        {
          "name": "idea_intake_stage_quality",
          "command": ["{python}", "checks/check_research_checklist.py"],
          "severity": "error",
          "config": {
            "path": "research/{topic_slug}/idea_brief.md",
            "checklist": "checklists/research/stage/idea_intake.md",
            "aspect": "idea_intake_stage_quality",
            "reasoning_effort": "medium"
          }
        }
      ],
      "transitions": [
        {
          "id": "map_world_knowledge",
          "when": "checks.idea_intake_status.metadata.status == \"clarified\"",
          "action": "advance",
          "to": "world_knowledge_map",
          "label": "进入 World Knowledge Map",
          "prompt": "idea 已经收敛。请构建已有研究解释边界、空白和争议的知识地图。"
        },
        {
          "id": "narrow_idea",
          "when": "checks.idea_intake_status.metadata.status == \"too_broad\"",
          "action": "repeat",
          "label": "收窄 idea",
          "prompt": "idea 仍然过宽。请重写 idea_brief.md，收窄现象、对象、机制和边界后再次验收。"
        },
        {
          "id": "request_scope_authority",
          "when": "checks.idea_intake_status.metadata.status == \"needs_user_authority\"",
          "action": "advance",
          "to": "user_scope_authority",
          "label": "请求用户确认范围",
          "prompt": "idea 需要用户授权或确认边界。请让用户确认后运行 approve/reject。"
        }
      ]
    },
    {
      "id": "user_scope_authority",
      "type": "human_approval",
      "title": "User Scope Authority",
      "transitions": [
        {
          "id": "scope_approved",
          "when": "user.approved",
          "action": "advance",
          "to": "world_knowledge_map",
          "label": "用户已确认范围",
          "prompt": "用户已确认研究边界。请进入 World Knowledge Map。"
        },
        {
          "id": "scope_rejected",
          "when": "user.rejected",
          "action": "advance",
          "to": "idea_intake",
          "label": "用户要求重写 idea",
          "prompt": "用户没有确认范围。请回到 Idea Intake 并重写 idea_brief.md。"
        }
      ]
    },
    {
      "id": "world_knowledge_map",
      "type": "stage",
      "title": "World Knowledge Map",
      "artifacts": [
        {
          "name": "knowledge_map",
          "path": "research/{topic_slug}/knowledge_map.md",
          "type": "markdown",
          "required": true
        }
      ],
      "checks": [
        {
          "name": "knowledge_map_sections",
          "command": ["{python}", "checks/check_markdown_sections.py"],
          "severity": "error",
          "config": {
            "path": "research/{topic_slug}/knowledge_map.md",
            "min_chars": 1400,
            "required_headings": [
              "# World Knowledge Map",
              "## Search Log",
              "## Literature Matrix",
              "## What Existing Work Explains",
              "## What Existing Work Does Not Explain",
              "## Knowledge Gaps",
              "## Status"
            ]
          }
        },
        {
          "name": "world_map_status",
          "command": ["{python}", "checks/check_research_status.py"],
          "severity": "error",
          "config": {
            "path": "research/{topic_slug}/knowledge_map.md",
            "allowed_statuses": ["searching", "mapped", "partial_coverage", "blocked", "stale"]
          }
        },
        {
          "name": "world_map_stage_quality",
          "command": ["{python}", "checks/check_research_checklist.py"],
          "severity": "error",
          "config": {
            "path": "research/{topic_slug}/knowledge_map.md",
            "checklist": "checklists/research/stage/world_knowledge_map.md",
            "aspect": "world_knowledge_map_stage_quality",
            "reasoning_effort": "medium"
          }
        }
      ],
      "transitions": [
        {
          "id": "discover_insight_direction",
          "when": "checks.world_map_status.metadata.status == \"mapped\"",
          "action": "advance",
          "to": "insight_direction_discovery",
          "label": "进入 insight direction discovery",
          "prompt": "知识地图已覆盖已有解释和缺口。请寻找候选信息增量。"
        },
        {
          "id": "continue_literature_mapping",
          "when": "checks.world_map_status.metadata.status == \"searching\" || checks.world_map_status.metadata.status == \"partial_coverage\" || checks.world_map_status.metadata.status == \"stale\"",
          "action": "repeat",
          "label": "继续补检索/更新知识地图",
          "prompt": "资料覆盖仍不足或过期。请补充检索、更新 literature matrix，并再次判断 Status。"
        },
        {
          "id": "record_search_blocker",
          "when": "checks.world_map_status.metadata.status == \"blocked\"",
          "action": "repeat",
          "label": "记录并处理检索阻断",
          "prompt": "检索被数据库、关键词或权限阻断。请在知识地图中记录 blocker，并尝试替代数据库或缩小范围。"
        }
      ]
    },
    {
      "id": "insight_direction_discovery",
      "type": "gate",
      "title": "Insight Direction Discovery",
      "decision_policy": {
        "mode": "model_choice",
        "require_reason": true
      },
      "artifacts": [
        {
          "name": "insight_direction",
          "path": "research/{topic_slug}/insight_direction.md",
          "type": "markdown",
          "required": true
        }
      ],
      "checks": [
        {
          "name": "insight_direction_sections",
          "command": ["{python}", "checks/check_markdown_sections.py"],
          "severity": "error",
          "config": {
            "path": "research/{topic_slug}/insight_direction.md",
            "min_chars": 1200,
            "required_headings": [
              "# Insight Direction Discovery",
              "## Candidate Information Delta",
              "## Information Delta Spine",
              "## Why Existing Work Does Not Already Cover It",
              "## Competing Directions",
              "## Status"
            ]
          }
        },
        {
          "name": "insight_direction_status",
          "command": ["{python}", "checks/check_research_status.py"],
          "severity": "error",
          "config": {
            "path": "research/{topic_slug}/insight_direction.md",
            "allowed_statuses": ["candidate", "promising", "weak", "derivative", "no_delta", "blocked"]
          }
        },
        {
          "name": "insight_direction_stage_quality",
          "command": ["{python}", "checks/check_research_checklist.py"],
          "severity": "error",
          "config": {
            "path": "research/{topic_slug}/insight_direction.md",
            "checklist": "checklists/research/stage/insight_direction_discovery.md",
            "aspect": "insight_direction_stage_quality",
            "reasoning_effort": "medium"
          }
        },
        {
          "name": "insight_direction_deep_quality",
          "command": ["{python}", "checks/check_research_checklist.py"],
          "severity": "error",
          "config": {
            "path": "research/{topic_slug}/insight_direction.md",
            "checklist": "checklists/research/deep/insight_direction_quality.md",
            "aspect": "insight_direction_deep_quality",
            "reasoning_effort": "high"
          }
        }
      ],
      "transitions": [
        {
          "id": "design_research",
          "when": "checks.insight_direction_status.metadata.status == \"candidate\" || checks.insight_direction_status.metadata.status == \"promising\"",
          "action": "advance",
          "to": "research_design",
          "label": "进入 Research Design",
          "prompt": "候选信息增量成立。请设计能检验这个增量的研究方案。"
        },
        {
          "id": "rebuild_knowledge_map_for_weak_delta",
          "when": "checks.insight_direction_status.metadata.status == \"weak\"",
          "action": "advance",
          "to": "world_knowledge_map",
          "label": "回知识地图补证据",
          "prompt": "信息增量较弱，可能是文献覆盖不足。请回到知识地图补充已有研究和缺口判断。"
        },
        {
          "id": "revise_candidate_direction",
          "when": "checks.insight_direction_status.metadata.status == \"weak\"",
          "action": "repeat",
          "label": "保留本阶段并重构候选方向",
          "prompt": "信息增量较弱，但可能通过重新定义机制或对象修复。请在 insight_direction.md 中重构候选方向。"
        },
        {
          "id": "restart_direction_discovery",
          "when": "checks.insight_direction_status.metadata.status == \"derivative\" || checks.insight_direction_status.metadata.status == \"no_delta\"",
          "action": "repeat",
          "label": "重新构思方向",
          "prompt": "当前方向没有足够信息增量。请重新寻找能成为主文贡献的方向，不做降级发表路径。"
        },
        {
          "id": "resolve_direction_blocker",
          "when": "checks.insight_direction_status.metadata.status == \"blocked\"",
          "action": "repeat",
          "label": "处理方向发现阻断",
          "prompt": "方向发现被资料、定义或责任边界阻断。请记录 blocker 并修复后再次验收。"
        }
      ]
    },
    {
      "id": "research_design",
      "type": "stage",
      "title": "Research Design",
      "artifacts": [
        {
          "name": "research_design",
          "path": "research/{topic_slug}/research_design.md",
          "type": "markdown",
          "required": true
        }
      ],
      "checks": [
        {
          "name": "research_design_sections",
          "command": ["{python}", "checks/check_markdown_sections.py"],
          "severity": "error",
          "config": {
            "path": "research/{topic_slug}/research_design.md",
            "min_chars": 1400,
            "required_headings": [
              "# Research Design",
              "## Research Question",
              "## Hypothesis or Mechanism",
              "## Evidence Design",
              "## Variables and Proxies",
              "## Identification or Comparison Strategy",
              "## Data Requirements",
              "## Status"
            ]
          }
        },
        {
          "name": "research_design_status",
          "command": ["{python}", "checks/check_research_status.py"],
          "severity": "error",
          "config": {
            "path": "research/{topic_slug}/research_design.md",
            "allowed_statuses": ["designed", "evidence_needed", "data_needed", "method_uncertain", "infeasible", "ready_for_data"]
          }
        },
        {
          "name": "research_design_stage_quality",
          "command": ["{python}", "checks/check_research_checklist.py"],
          "severity": "error",
          "config": {
            "path": "research/{topic_slug}/research_design.md",
            "checklist": "checklists/research/stage/research_design.md",
            "aspect": "research_design_stage_quality",
            "reasoning_effort": "medium"
          }
        },
        {
          "name": "research_design_deep_quality",
          "command": ["{python}", "checks/check_research_checklist.py"],
          "severity": "error",
          "config": {
            "path": "research/{topic_slug}/research_design.md",
            "checklist": "checklists/research/deep/research_design_quality.md",
            "aspect": "research_design_deep_quality",
            "reasoning_effort": "high"
          }
        }
      ],
      "transitions": [
        {
          "id": "acquire_data",
          "when": "checks.research_design_status.metadata.status == \"designed\" || checks.research_design_status.metadata.status == \"ready_for_data\"",
          "action": "advance",
          "to": "data_acquisition",
          "label": "进入 Data Acquisition",
          "prompt": "研究方案已经清楚。请寻找或构建能支撑该方向的数据。"
        },
        {
          "id": "repair_research_design",
          "when": "checks.research_design_status.metadata.status == \"evidence_needed\" || checks.research_design_status.metadata.status == \"data_needed\" || checks.research_design_status.metadata.status == \"method_uncertain\"",
          "action": "repeat",
          "label": "修正研究设计",
          "prompt": "研究设计还不够可执行。请修正方法、指标、代理变量或证据链。"
        },
        {
          "id": "return_to_direction_after_infeasible_design",
          "when": "checks.research_design_status.metadata.status == \"infeasible\"",
          "action": "advance",
          "to": "insight_direction_discovery",
          "label": "回到方向发现",
          "prompt": "当前设计不可行。请回到方向发现，寻找新的主文级信息增量。"
        }
      ]
    },
    {
      "id": "data_acquisition",
      "type": "stage",
      "title": "Data Acquisition",
      "artifacts": [
        {
          "name": "data_acquisition",
          "path": "research/{topic_slug}/data_acquisition.md",
          "type": "markdown",
          "required": true
        },
        {
          "name": "source_evidence_pack",
          "path": "research/{topic_slug}/source_evidence_pack.csv",
          "type": "csv",
          "required": true
        },
        {
          "name": "data_fitness_matrix",
          "path": "research/{topic_slug}/data_fitness_matrix.csv",
          "type": "csv",
          "required": true
        }
      ],
      "checks": [
        {
          "name": "data_acquisition_sections",
          "command": ["{python}", "checks/check_markdown_sections.py"],
          "severity": "error",
          "config": {
            "path": "research/{topic_slug}/data_acquisition.md",
            "min_chars": 1100,
            "required_headings": [
              "# Data Acquisition",
              "## Source Register",
              "## Acquisition Log",
              "## Data Manifest",
              "## Data Fitness for Research Design",
              "## Bias or Permission Risks",
              "## Status"
            ]
          }
        },
        {
          "name": "data_acquisition_status",
          "command": ["{python}", "checks/check_research_status.py"],
          "severity": "error",
          "config": {
            "path": "research/{topic_slug}/data_acquisition.md",
            "allowed_statuses": ["searching", "acquired", "substitute_found", "insufficient", "biased", "permission_blocked", "infeasible"]
          }
        },
        {
          "name": "source_evidence_pack_contract",
          "command": ["{python}", "checks/check_research_csv_contract.py"],
          "severity": "error",
          "config": {
            "path": "research/{topic_slug}/source_evidence_pack.csv",
            "min_rows": 6,
            "required_columns": ["source_id", "title", "source_type", "authority_level", "url", "accessed_date", "locator", "excerpt_or_summary", "extracted_fact", "uncertainty", "used_in_claims"],
            "nonempty_columns": ["source_id", "title", "source_type", "authority_level", "url", "accessed_date", "extracted_fact", "used_in_claims"],
            "allowed_values": {
              "source_type": ["law", "official_report", "official_guidance", "dataset", "academic_paper", "working_paper", "news", "secondary_analysis", "other"],
              "authority_level": ["primary", "official", "peer_reviewed", "working_paper", "secondary", "weak"]
            }
          }
        },
        {
          "name": "data_fitness_matrix_contract",
          "command": ["{python}", "checks/check_research_csv_contract.py"],
          "severity": "error",
          "config": {
            "path": "research/{topic_slug}/data_fitness_matrix.csv",
            "min_rows": 3,
            "required_columns": ["claim_id", "data_source_or_proxy", "directness", "supports_claim", "cannot_support", "distortion_risk", "mitigation", "routing_decision"],
            "allowed_values": {
              "directness": ["direct", "proxy", "substitute", "background"],
              "routing_decision": ["proceed", "narrow_claim", "repair_data", "return_to_design", "blocked"]
            }
          }
        },
        {
          "name": "source_evidence_deep_quality",
          "command": ["{python}", "checks/check_research_checklist.py"],
          "severity": "error",
          "config": {
            "path": "research/{topic_slug}/source_evidence_pack.csv",
            "checklist": "checklists/research/deep/source_evidence_quality.md",
            "aspect": "source_evidence_deep_quality",
            "reasoning_effort": "high"
          }
        },
        {
          "name": "data_fitness_for_claim_quality",
          "command": ["{python}", "checks/check_research_checklist.py"],
          "severity": "error",
          "config": {
            "path": "research/{topic_slug}/data_fitness_matrix.csv",
            "checklist": "checklists/research/deep/data_fitness_for_claim.md",
            "aspect": "data_fitness_for_claim_quality",
            "reasoning_effort": "high"
          }
        },
        {
          "name": "data_acquisition_stage_quality",
          "command": ["{python}", "checks/check_research_checklist.py"],
          "severity": "error",
          "config": {
            "path": "research/{topic_slug}/data_acquisition.md",
            "checklist": "checklists/research/stage/data_acquisition.md",
            "aspect": "data_acquisition_stage_quality",
            "reasoning_effort": "medium"
          }
        },
        {
          "name": "data_acquisition_deep_quality",
          "command": ["{python}", "checks/check_research_checklist.py"],
          "severity": "error",
          "config": {
            "path": "research/{topic_slug}/data_acquisition.md",
            "checklist": "checklists/research/deep/data_quality.md",
            "aspect": "data_acquisition_deep_quality",
            "reasoning_effort": "high"
          }
        }
      ],
      "transitions": [
        {
          "id": "run_analysis",
          "when": "checks.data_acquisition_status.metadata.status == \"acquired\" || checks.data_acquisition_status.metadata.status == \"substitute_found\"",
          "action": "advance",
          "to": "analysis",
          "label": "进入 Analysis",
          "prompt": "数据已经可用。请执行分析并记录 run manifest、outputs 和 findings。"
        },
        {
          "id": "continue_data_search",
          "when": "checks.data_acquisition_status.metadata.status == \"searching\" || checks.data_acquisition_status.metadata.status == \"insufficient\" || checks.data_acquisition_status.metadata.status == \"biased\" || checks.data_acquisition_status.metadata.status == \"permission_blocked\"",
          "action": "repeat",
          "label": "继续找数据或替代数据",
          "prompt": "当前数据不足、偏差过大或存在权限问题。请换数据、缩小问题或找替代数据。"
        },
        {
          "id": "return_to_direction_after_data_infeasible",
          "when": "checks.data_acquisition_status.metadata.status == \"infeasible\"",
          "action": "advance",
          "to": "insight_direction_discovery",
          "label": "数据不可行，回方向发现",
          "prompt": "数据无法支撑当前方向。请回到 insight direction discovery，不做降级发表。"
        }
      ]
    },
    {
      "id": "analysis",
      "type": "stage",
      "title": "Analysis",
      "decision_policy": {
        "mode": "model_choice",
        "require_reason": true
      },
      "artifacts": [
        {
          "name": "analysis_findings",
          "path": "research/{topic_slug}/analysis_findings.md",
          "type": "markdown",
          "required": true
        },
        {
          "name": "claim_evidence_trace",
          "path": "research/{topic_slug}/claim_evidence_trace.csv",
          "type": "csv",
          "required": true
        }
      ],
      "checks": [
        {
          "name": "analysis_sections",
          "command": ["{python}", "checks/check_markdown_sections.py"],
          "severity": "error",
          "config": {
            "path": "research/{topic_slug}/analysis_findings.md",
            "min_chars": 1300,
            "required_headings": [
              "# Analysis Findings",
              "## Run Manifest",
              "## Outputs",
              "## Observed Pattern",
              "## Robustness or Sensitivity",
              "## Interpretation",
              "## Status"
            ]
          }
        },
        {
          "name": "analysis_status",
          "command": ["{python}", "checks/check_research_status.py"],
          "severity": "error",
          "config": {
            "path": "research/{topic_slug}/analysis_findings.md",
            "allowed_statuses": ["running", "produced", "robust", "surprising", "null", "noisy", "weak", "failed"]
          }
        },
        {
          "name": "claim_evidence_trace_contract",
          "command": ["{python}", "checks/check_research_csv_contract.py"],
          "severity": "error",
          "config": {
            "path": "research/{topic_slug}/claim_evidence_trace.csv",
            "min_rows": 4,
            "required_columns": ["claim_id", "claim", "claim_type", "claim_strength", "evidence_ids", "source_ids", "method_support", "boundary", "falsification_test", "negative_evidence", "status"],
            "allowed_values": {
              "claim_type": ["central", "supporting", "boundary", "rejected", "background"],
              "claim_strength": ["descriptive", "mechanism", "correlational", "causal", "speculative"],
              "status": ["supported", "bounded", "weak", "rejected", "needs_repair"]
            }
          }
        },
        {
          "name": "claim_trace_link_integrity",
          "command": ["{python}", "checks/check_research_trace_links.py"],
          "severity": "error",
          "config": {
            "claim_trace": "research/{topic_slug}/claim_evidence_trace.csv",
            "source_pack": "research/{topic_slug}/source_evidence_pack.csv",
